// Remove every line that starts with // before using this file: JSON does not allow comments.
// Lines marked Staggering: are the settings that make sites on one GPU agent take turns; the rest is a
// regular NVFlare job.
{
  "format_version": 2,
  "task_data_filters": [],
  "task_result_filters": [],
  "workflows": [
    {
      "id": "staggered_fed_avg",
      // Staggering: FedAvg that limits how many sites train at once on each GPU agent
      // (app/custom/staggered_fed_avg.py).
      "path": "staggered_fed_avg.StaggeredFedAvg",
      "args": {
        // Staggering (optional, default 2): K, the sites of one agent that train at the same time. K training sites
        // plus ~0.3 GB per waiting site must fit in the GPU; see 'Choosing K' in the guide.
        "max_concurrent": 4,
        // Staggering (optional, default {} = every agent uses max_concurrent): per-agent overrides of max_concurrent,
        // keyed by agent name, e.g. {"gpu_agent_a": 4, "gpu_agent_b": 2}.
        "agent_max_concurrent": {},
        // Staggering (optional, default "_\\d+$"): regex removed from a site name to get its agent; sites with the same
        // result share one GPU agent. The default turns my_agent_3 into my_agent.
        "agent_name_pattern": "_\\d+$",
        // Staggering (optional, default 300): seconds round 0 waits for num_clients sites to connect before stopping
        // the job.
        "wait_for_clients_timeout": 300,
        // Staggering (optional, default "batch"): "sliding" starts a waiting site as soon as any slot frees (faster,
        // recommended); "batch" waits for the whole wave of K to finish first.
        "wave_mode": "sliding",
        // Staggering (required): set to the number of sites (datasets) in the job. Every site trains every round;
        // FedAvg's usual sampling of num_clients sites is not used.
        "num_clients": 8,
        // Staggering (optional, default num_clients): sites that must succeed for a round to count. The default
        // requires every site, so one failed site stops the job for every workgroup; set it lower to tolerate failures.
        "min_successful_clients": 7,
        // Staggering (optional, default true): a site that fails is skipped for the rest of the job instead of holding
        // a slot until train_timeout every round.
        "exclude_failed_clients": true,
        // Staggering (optional, default 0): retries of a failed site within the same round. Keep 0: a site whose
        // training failed usually fails again.
        "max_retries": 0,
        "num_rounds": 3,
        // Staggering (optional, default 0 = no limit; set it): seconds one site may train, counted from when its turn
        // starts, not from the round start. About 1.5 x one site's local training time. With no limit, a hung site
        // holds its slot forever.
        "train_timeout": 900,
        "persistor_id": "persistor"
      }
    }
  ],
  "components": [
    {
      "id": "persistor",
      "path": "nvflare.app_opt.pt.file_model_persistor.PTFileModelPersistor",
      "args": {
        "model": {
          "path": "chemprop_fl_classification.ClassificationMPNN"
        },
        "global_model_file_name": "/output/model_parameters.pt"
      }
    },
    {
      "id": "model_selector",
      "path": "nvflare.app_common.widgets.intime_model_selector.IntimeModelSelector",
      "args": {
        "key_metric": "val/roc"
      }
    }
  ]
}
